{
  "datasets": [
    {
      "name": "ds_totals",
      "displayName": "Totais e reconciliação",
      "queryLines": [
        "SELECT b.batch_id,\n",
        "       b.status,\n",
        "       b.reference_month,\n",
        "       b.demo_mode,\n",
        "       b.total_pos_brl,\n",
        "       b.total_distributor_brl,\n",
        "       COALESCE(n.pos_lines, 0) AS pos_lines,\n",
        "       COALESCE(n.distributor_lines, 0) AS distributor_lines,\n",
        "       COALESCE(n.flagged_lines, 0) AS flagged_lines,\n",
        "       r.status AS reconciliation_status,\n",
        "       r.lines_compared,\n",
        "       r.max_line_diff_brl,\n",
        "       r.total_diff_brl,\n",
        "       r.pos_control_diff_brl,\n",
        "       r.distributor_control_diff_brl\n",
        "FROM batches b\n",
        "LEFT JOIN (\n",
        "  SELECT batch_id,\n",
        "         COUNT_IF(beneficiary_type = 'pos') AS pos_lines,\n",
        "         COUNT_IF(beneficiary_type = 'distributor') AS distributor_lines,\n",
        "         COUNT_IF(size(flags) > 0) AS flagged_lines\n",
        "  FROM batch_lines\n",
        "  GROUP BY batch_id\n",
        ") n ON n.batch_id = b.batch_id\n",
        "LEFT JOIN (\n",
        "  SELECT *\n",
        "  FROM reconciliation\n",
        "  QUALIFY row_number() OVER (PARTITION BY batch_id ORDER BY checked_at_utc DESC) = 1\n",
        ") r ON r.batch_id = b.batch_id\n"
      ]
    },
    {
      "name": "ds_top20",
      "displayName": "Top 20 maiores linhas",
      "queryLines": [
        "SELECT batch_id,\n",
        "       rnk,\n",
        "       beneficiary_type,\n",
        "       beneficiary_id,\n",
        "       tier,\n",
        "       base_amount_brl,\n",
        "       rate,\n",
        "       commission_brl,\n",
        "       array_join(COALESCE(flags, array()), ', ') AS flags\n",
        "FROM (\n",
        "  SELECT l.*,\n",
        "         row_number() OVER (\n",
        "           PARTITION BY batch_id\n",
        "           ORDER BY commission_brl DESC, beneficiary_type, beneficiary_id\n",
        "         ) AS rnk\n",
        "  FROM batch_lines l\n",
        ")\n",
        "WHERE rnk <= 20\n",
        "ORDER BY batch_id, rnk\n"
      ]
    },
    {
      "name": "ds_flagged",
      "displayName": "Linhas com flag",
      "queryLines": [
        "SELECT batch_id,\n",
        "       beneficiary_type,\n",
        "       beneficiary_id,\n",
        "       tier,\n",
        "       base_amount_brl,\n",
        "       commission_brl,\n",
        "       array_join(flags, ', ') AS flags\n",
        "FROM batch_lines\n",
        "WHERE size(flags) > 0\n",
        "ORDER BY batch_id, commission_brl DESC, beneficiary_id\n"
      ]
    },
    {
      "name": "ds_flag_counts",
      "displayName": "Flags por tipo",
      "queryLines": [
        "SELECT batch_id,\n",
        "       flag,\n",
        "       COUNT(*) AS lines\n",
        "FROM (SELECT batch_id, explode(flags) AS flag FROM batch_lines)\n",
        "GROUP BY batch_id, flag\n",
        "ORDER BY batch_id, flag\n"
      ]
    },
    {
      "name": "ds_previous_totals",
      "displayName": "Totais contra o mês anterior",
      "queryLines": [
        "-- Lote anterior = último lote locked do mês civil anterior (maior versão; lotes ADJ não contam).\n",
        "WITH previous AS (\n",
        "  SELECT b.batch_id, p.batch_id AS previous_batch_id\n",
        "  FROM batches b\n",
        "  JOIN batches p\n",
        "    ON p.reference_month = add_months(b.reference_month, -1)\n",
        "   AND p.status = 'locked'\n",
        "   AND p.batch_id NOT LIKE '%-ADJ-%'\n",
        "  QUALIFY row_number() OVER (PARTITION BY b.batch_id ORDER BY p.version DESC) = 1\n",
        ")\n",
        "SELECT b.batch_id,\n",
        "       pv.previous_batch_id,\n",
        "       b.total_pos_brl,\n",
        "       p.total_pos_brl AS previous_total_pos_brl,\n",
        "       b.total_distributor_brl,\n",
        "       p.total_distributor_brl AS previous_total_distributor_brl\n",
        "FROM batches b\n",
        "LEFT JOIN previous pv ON pv.batch_id = b.batch_id\n",
        "LEFT JOIN batches p ON p.batch_id = pv.previous_batch_id\n"
      ]
    },
    {
      "name": "ds_previous_pos",
      "displayName": "PDVs contra o mês anterior",
      "queryLines": [
        "-- Os 50 PDVs com maior mudança de comissão contra o último lote locked do mês anterior\n",
        "-- (a mesma definição de `previous_totals.sql`). Sem lote anterior, não há linhas.\n",
        "WITH previous AS (\n",
        "  SELECT b.batch_id, p.batch_id AS previous_batch_id\n",
        "  FROM batches b\n",
        "  JOIN batches p\n",
        "    ON p.reference_month = add_months(b.reference_month, -1)\n",
        "   AND p.status = 'locked'\n",
        "   AND p.batch_id NOT LIKE '%-ADJ-%'\n",
        "  QUALIFY row_number() OVER (PARTITION BY b.batch_id ORDER BY p.version DESC) = 1\n",
        "),\n",
        "compared AS (\n",
        "  SELECT l.batch_id,\n",
        "         pv.previous_batch_id,\n",
        "         l.beneficiary_id,\n",
        "         l.tier,\n",
        "         o.tier AS previous_tier,\n",
        "         l.commission_brl,\n",
        "         o.commission_brl AS previous_commission_brl,\n",
        "         l.commission_brl - COALESCE(o.commission_brl, 0) AS change_brl,\n",
        "         array_join(COALESCE(l.flags, array()), ', ') AS flags\n",
        "  FROM batch_lines l\n",
        "  JOIN previous pv ON pv.batch_id = l.batch_id\n",
        "  LEFT JOIN batch_lines o\n",
        "    ON o.batch_id = pv.previous_batch_id\n",
        "   AND o.beneficiary_type = 'pos'\n",
        "   AND o.beneficiary_id = l.beneficiary_id\n",
        "  WHERE l.beneficiary_type = 'pos'\n",
        ")\n",
        "SELECT *\n",
        "FROM compared\n",
        "QUALIFY row_number() OVER (\n",
        "  PARTITION BY batch_id ORDER BY abs(change_brl) DESC, beneficiary_id\n",
        ") <= 50\n",
        "ORDER BY batch_id, abs(change_brl) DESC, beneficiary_id\n"
      ]
    }
  ],
